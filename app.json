{
  "expo": {
    "name": "100 Food Recipes",
    "slug": "100-food-recipes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.anonymous.x100foodrecipes"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20f7912a-6ed4-4514-bb5c-aad3f89e65a4"
      }
    }
  }
}
